# Server-only Agent Studio values for /api/agent-handoff.
# Never prefix these with NEXT_PUBLIC_ and never place them in public/agent-handoff.js.
ALGOLIA_APPLICATION_ID=
ALGOLIA_AGENT_STUDIO_API_KEY=
SALES_AGENT_STUDIO_AGENT_ID=
SUPPORT_AGENT_STUDIO_AGENT_ID=

# Comma-separated exact browser origins allowed to call the public embed API.
# Add the exact Algolia blog origin after verifying it; same-origin requests are allowed automatically.
AGENT_HANDOFF_ALLOWED_ORIGINS=
